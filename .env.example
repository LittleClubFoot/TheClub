# ============================================================================
# The Club - Environment Variables
# ============================================================================
# Copy this file to .env and customize for your setup:
#   cp .env.example .env
#
# Generate a secure token with: make notes-token
# ============================================================================

# Auth token for accessing protected notes endpoints
# Required for creating/editing/deleting notes
CLUB_AUTH_TOKEN=changeme

# Base URL used for generating QR codes and shareable links
# Set this to your public domain
CLUB_BASE_URL=https://pochita.synology.me

# Notes data directory (default: data/notes)
# Can be pointed at a Synology NAS mount for persistent storage
# CLUB_NOTES_DIR=/volume1/docker/theclub/notes
