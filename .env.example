# ============================================================================
# The Club Dashboard - Environment Variables
# ============================================================================
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# ============================================================================

# --------------------------------------------------------------------------
# Gitea Configuration
# --------------------------------------------------------------------------

# Domain settings (update for production)
GITEA_ROOT_URL=https://localhost/gitea/
GITEA_DOMAIN=localhost
GITEA_SSH_DOMAIN=localhost

# --------------------------------------------------------------------------
# Woodpecker CI Configuration
# --------------------------------------------------------------------------

# External URL for Woodpecker (update for production)
WOODPECKER_HOST=https://localhost/ci

# Admin username (must match a Gitea account)
WOODPECKER_ADMIN=theclub

# Gitea OAuth2 credentials
# Create these in Gitea: Site Administration > Applications > Create OAuth2 App
# Redirect URI: https://localhost/ci/authorize
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

# Shared secret between Woodpecker server and agent
# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=
