#     reverse_proxy service:port
# }

# ============================================================================
# HEALTH CHECK ENDPOINT (Optional - useful for monitoring)
# ============================================================================

health.pochita.synology.me {
    respond "OK" 200
}

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Replace [SYNOLOGY_IP] with your Synology's local IP address
#    Example: 192.168.1.10
#
# 2. Ensure wildcard DNS is configured:
#    *.pochita.synology.me → Your public IP
#
# 3. Port forwarding required:
#    - 80 → Club server (HTTP for ACME challenge)
#    - 443 → Club server (HTTPS)
#    - 51820 → Club server (WireGuard VPN)
#
# 4. Let's Encrypt rate limits:
#    - 50 certificates per domain per week
#    - 5 certificates per hostname per week
#    - Use staging CA for testing (uncomment in global options)
#
# 5. Authelia protection:
#    - Services with forward_auth require login
#    - Configure access control in authelia/configuration.yml
#    - Can be one_factor or two_factor (recommended)
#
# 6. Logging:
#    - All access logs in /var/log/caddy/
#    - Rotation: 100MB per file, keep 5 files, 30 days retention
#    - JSON format for easy parsing
#
# 7. Security headers:
#    - HSTS enabled with 1 year max-age
#    - CSP configured for common services
#    - Adjust CSP if services break (check browser console)
#
# 8. Troubleshooting:
#    - Check logs: docker logs caddy
#    - Validate config: docker exec caddy caddy validate --config /etc/caddy/Caddyfile
#    - Test forward auth: curl -I https://grafana.pochita.synology.me
#    - Check certificates: docker exec caddy caddy list-certificates
#
# ============================================================================
